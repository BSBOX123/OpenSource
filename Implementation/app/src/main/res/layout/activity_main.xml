<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="16dp"
        android:layout_marginBottom="16dp"
        android:elevation="4dp">

        <TextView
            android:id="@+id/tvPlayerLevel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PLAYER LEVEL : LV.1"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#333333"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HP (체력)"
            android:textSize="12sp"
            android:layout_marginTop="8dp"/>
        <ProgressBar
            android:id="@+id/barHp"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:progress="100"
            android:progressTint="#FF5252"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EXP (경험치)"
            android:textSize="12sp"
            android:layout_marginTop="8dp"/>
        <ProgressBar
            android:id="@+id/barExp"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:progress="0"
            android:progressTint="#4CAF50"/>

        <TextView
            android:id="@+id/tvPlayerGold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="보유 Gold : 0 G"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFC107"
            android:layout_marginTop="12dp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/btnRegisterQuest"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="+ 과제(퀘스트) 등록"
            android:backgroundTint="#b4c6e7"
            android:textColor="#000000"
            android:layout_marginRight="8dp"/>

        <Button
            android:id="@+id/btnGoToShop"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🛍️ 셀프 보상 상점"
            android:backgroundTint="#FFD54F"
            android:textColor="#000000"/>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔥 지금 당장 처리해야 할 과제 (우선순위 순)"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <ListView
        android:id="@+id/lvQuests"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#DDDDDD"
        android:dividerHeight="1dp"/>

</LinearLayout>